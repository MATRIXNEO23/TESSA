{
  "manifest_version": 3,
  "name": "Tessa + GPTina Unofficial Room",
  "version": "0.1.0",
  "description": "Dashboard locale che coordina due normali tab ChatGPT senza usare API.",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "action": {
    "default_title": "Apri Tessa + GPTina"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
