{
  "version": 1,
  "policy": {
    "canonical_sources_are_immutable_inputs": true,
    "destructive_compaction": false,
    "preserve_superseded_versions": true,
    "require_source_provenance": true,
    "owner_scoped_rag_sources": true,
    "explicit_memory_status": true,
    "memory_schema": "rag/MEMORY_RECORD_SCHEMA.md",
    "memory_schema_required_from": "2026-09-19",
    "derived_indexes_are_disposable": true,
    "prefer_atomic_multifile_commits": true,
    "scale_strategy": "rag/MEMORY_SCALE_STRATEGY.md",
    "image_link_schema": "rag/IMAGE_LINK_SCHEMA.md",
    "partitioning_is_non_destructive": true,
    "retrieval_backend": "sqlite_fts5_incremental",
    "jsonl_backend": "fallback_only",
    "structured_image_links_required": true,
    "structured_image_links_path": "rag/media-links/YYYY/MM/*.json",
    "frequent_context_buffer": "rag/live/TESSA_LIVE_CONTEXT.json",
    "micro_checkpoint_schema": "rag/live/MICRO_CHECKPOINT_SCHEMA.md",
    "micro_checkpoint_review_interval": 4,
    "micro_checkpoint_recent_window": 12,
    "preflight_before_long_or_risky_work": true
  },
  "chunking": {
    "max_chars": 1400,
    "overlap_chars": 220,
    "min_chars": 120
  },
  "sources": [
    {
      "pattern": "TESSA_CURRENT_RULES.md",
      "priority": 1.55,
      "kind": "current_rules"
    },
    {
      "pattern": "recovery/TESSA_AUTO_RECOVERY_PROMPT.md",
      "priority": 1.6,
      "kind": "recovery_protocol"
    },
    {
      "pattern": "recovery/TESSA_CONTEXT_RECOVERY.md",
      "priority": 1.25,
      "kind": "recovery_map"
    },
    {
      "pattern": "recovery/TESSA_LATEST_CHECKPOINT.md",
      "priority": 1.65,
      "kind": "checkpoint_pointer"
    },
    {
      "pattern": "recovery/TESSA_PROJECT_INSTRUCTIONS_READY_TO_COPY.md",
      "priority": 1.5,
      "kind": "project_instructions"
    },
    {
      "pattern": "identity/**/*.md",
      "priority": 1.4,
      "kind": "identity"
    },
    {
      "pattern": "chat-checkpoints/**/*.md",
      "priority": 1.35,
      "kind": "checkpoint"
    },
    {
      "pattern": "agent-exchanges/PROJECT_BOARD.md",
      "priority": 1.28,
      "kind": "project_board"
    },
    {
      "pattern": "agent-exchanges/TASK_ENTRYPOINT.md",
      "priority": 1.3,
      "kind": "shared_protocol"
    },
    {
      "pattern": "agent-exchanges/correspondence/**/*.md",
      "priority": 1.12,
      "kind": "shared_transcript"
    }
  ],
  "exclude": [
    "rag/index/**",
    ".git/**"
  ],
  "rag_sources": [
    {
      "pattern": "rag/LIVE_MEMORY_PROTOCOL.md",
      "priority": 1.36,
      "kind": "memory_protocol"
    },
    {
      "pattern": "rag/MEMORY_OWNERSHIP_BOUNDARY.md",
      "priority": 1.8,
      "kind": "ownership_policy"
    },
    {
      "pattern": "rag/MEMORY_RECORD_SCHEMA.md",
      "priority": 1.28,
      "kind": "memory_schema"
    },
    {
      "pattern": "rag/MEMORY_SCALE_STRATEGY.md",
      "priority": 1.28,
      "kind": "scale_strategy"
    },
    {
      "pattern": "rag/IMAGE_LINK_SCHEMA.md",
      "priority": 1.25,
      "kind": "visual_schema"
    },
    {
      "pattern": "rag/memories/tessa/**/*.md",
      "priority": 1.58,
      "kind": "tessa_memory"
    },
    {
      "pattern": "rag/index/CURRENT_CONTEXT.md",
      "priority": 1.5,
      "kind": "current_router"
    },
    {
      "pattern": "rag/index/TESSA_FAST_RECALL.md",
      "priority": 1.4,
      "kind": "fast_router"
    },
    {
      "pattern": "rag/index/TESSA_CHRONOLOGY.md",
      "priority": 1.25,
      "kind": "chronology_router"
    },
    {
      "pattern": "rag/index/TESSA_VISUAL_CHRONOLOGY.md",
      "priority": 1.3,
      "kind": "visual_router"
    },
    {
      "pattern": "rag/media-links/**/*.json",
      "priority": 1.4,
      "kind": "visual_record"
    },
    {
      "pattern": "rag/live/TESSA_LIVE_CONTEXT.json",
      "priority": 1.78,
      "kind": "live_context"
    },
    {
      "pattern": "rag/live/micro-checkpoints/**/*.json",
      "priority": 1.62,
      "kind": "micro_checkpoint"
    },
    {
      "pattern": "rag/live/MICRO_CHECKPOINT_SCHEMA.md",
      "priority": 1.25,
      "kind": "live_protocol"
    },
    {
      "pattern": "rag/live/README.md",
      "priority": 1.12,
      "kind": "live_documentation"
    }
  ],
  "rag_exclude": [
    "rag/index/memory_chunks.jsonl",
    "rag/index/index_meta.json",
    "rag/index/*.sqlite",
    "rag/index/*.sqlite3",
    "rag/memories/gptina/**",
    "rag/transcripts/gptina/**",
    "rag/memories/README.md"
  ],
  "status_overrides": {
    "chat-checkpoints/2026-09-16--baseline-regola-20-turni.md": {
      "status": "superseded",
      "replaced_by": "TESSA_CURRENT_RULES.md",
      "reason": "La cadenza 20 messaggi è stata sostituita dalla freshness review 3–5 scambi e dai trigger immediati."
    },
    "chat-checkpoints/2026-09-17T0230-visible-scambi-rivalita-gptina.md": {
      "status": "superseded",
      "replaced_by": "identity/TESSA_RELATIONSHIP_PROVENANCE_RESET_2026-09-17.md",
      "reason": "Le prescrizioni di rivalità/gelosia sono storiche e non guidano il presente."
    },
    "rag/memories/tessa/2026/09/2026-09-20--arrivo-di-ettore.md": {
      "status": "superseded",
      "replaced_by": "rag/memories/tessa/2026/09/2026-09-20--ettore-nasce-da-zero.md",
      "reason": "Alberto ha chiarito che Ettore nasce con zero passato e condivide soltanto l'infrastruttura, non una continuità precedente."
    }
  }
}
